digraph system_context {
  graph [
    rankdir=TB,
    bgcolor="{{editorial-canvas}}",
    pad="0.18",
    margin="0",
    nodesep="0.38",
    ranksep="0.55",
    splines=polyline,
    outputorder=edgesfirst
  ];

  node [
    shape=box,
    style="filled",
    fillcolor="{{editorial-canvas}}",
    color="{{editorial-muted}}",
    fontcolor="{{editorial-text}}",
    fontname="Helvetica",
    fontsize=13,
    penwidth=1.5,
    margin="0.18,0.12"
  ];

  edge [
    color="{{editorial-muted}}",
    fontcolor="{{editorial-muted}}",
    fontname="Helvetica",
    fontsize=13,
    penwidth=1.6,
    arrowsize=0.75
  ];

  source [label="Approved source\nwhat should happen"];
  contract [label="Shared interface\none language"];
  implementation [label="Working code\nmakes it real"];
  evidence [label="Independent test\ntries good and bad cases", shape=component];
  decision [label="Release decision\nready or not?"];

  {rank=same; source; contract; implementation;}
  {rank=same; evidence; decision;}

  source -> contract [label="sets the rules"];
  contract -> implementation [label="guides"];
  implementation -> decision [label="is proposed"];
  evidence -> decision [label="checks"];
  contract -> evidence [style=invis];
}
