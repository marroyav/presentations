\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{beamerthemeDUNEProfessional.sty}[2026/08/19 DUNE professional Beamer theme v2]

\mode<presentation>

\RequirePackage{iftex}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{adjustbox}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{ragged2e}

\usetikzlibrary{arrows.meta,calc,fit,positioning,shapes.geometric}

\useinnertheme{default}
\useoutertheme{default}
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}

% Logo path is relative to a deck directory. Override with \DuneSetLogoPath.
\newcommand{\DuneLogoPath}{../../templates/dune-professional/logos}
\newcommand{\DuneSetLogoPath}[1]{\renewcommand{\DuneLogoPath}{#1}}

% Canonical design tokens. These values are checked against design-tokens.json.
% Brand anchors follow Fermilab's published palette; paper, sky, and coral are
% high-contrast layout surfaces derived from the earlier clear/dark decks.
\definecolor{DuneBackground}{HTML}{101820}
\definecolor{DuneSurface}{HTML}{1B2733}
\definecolor{DuneSurfaceRaised}{HTML}{263645}
\definecolor{DuneTitleSurface}{HTML}{20303E}
\definecolor{DuneBorder}{HTML}{536878}
\definecolor{DuneText}{HTML}{F1F5F7}
\definecolor{DuneTextMuted}{HTML}{BAC6CF}
\definecolor{DunePrimary}{HTML}{F68D2E}
\definecolor{DuneInfo}{HTML}{41B6E6}
\definecolor{DuneSuccess}{HTML}{78BE20}
\definecolor{DuneWarning}{HTML}{FED141}
\definecolor{DuneDanger}{HTML}{AF272F}
\definecolor{DunePaper}{HTML}{F3EADB}
\definecolor{DuneSky}{HTML}{A8DDEB}
\definecolor{DuneCoral}{HTML}{F3A07A}
\definecolor{DuneOnAccent}{HTML}{101820}
\definecolor{DuneOnDanger}{HTML}{FFFFFF}

% Compatibility aliases for existing decks. New material should use the
% semantic names above or the role-based components below.
\colorlet{DuneBg}{DuneBackground}
\colorlet{DunePanel}{DuneSurface}
\colorlet{DunePanelAlt}{DuneSurfaceRaised}
\colorlet{DuneTitleBand}{DuneTitleSurface}
\colorlet{DuneLine}{DuneBorder}
\colorlet{DuneMuted}{DuneTextMuted}
\colorlet{DuneOrange}{DunePrimary}
\colorlet{DuneCyan}{DuneInfo}
\colorlet{DuneMint}{DuneSuccess}
\colorlet{DuneYellow}{DuneWarning}
\colorlet{DuneRed}{DuneDanger}
\colorlet{DuneViolet}{DuneInfo}

\setbeamercolor{normal text}{fg=DuneText,bg=DuneBackground}
\setbeamercolor{title}{fg=DuneText,bg=DuneBackground}
\setbeamercolor{subtitle}{fg=DuneTextMuted,bg=DuneBackground}
\setbeamercolor{author}{fg=DuneSky,bg=DuneBackground}
\setbeamercolor{date}{fg=DuneTextMuted,bg=DuneBackground}
\setbeamercolor{frametitle}{fg=DuneText,bg=DuneBackground}
\setbeamercolor{headline}{fg=DuneTextMuted,bg=DuneBackground}
\setbeamercolor{footline}{fg=DuneTextMuted,bg=DuneBackground}
\setbeamercolor{itemize item}{fg=DuneCoral}
\setbeamercolor{itemize subitem}{fg=DuneSky}
\setbeamercolor{enumerate item}{fg=DuneCoral}
\setbeamercolor{caption name}{fg=DuneTextMuted}

\setbeamercolor{dune panel}{fg=DuneText,bg=DuneSurface}
\setbeamercolor{dune panel alt}{fg=DuneText,bg=DuneSurfaceRaised}

% Legacy card roles intentionally share neutral surfaces. Meaning belongs in a
% small role label, icon, line style, or explicit words—not a wall of color.
\setbeamercolor{dune accent}{fg=DuneText,bg=DuneSurfaceRaised}
\setbeamercolor{dune decision}{fg=DuneText,bg=DuneSurfaceRaised}
\setbeamercolor{dune risk}{fg=DuneText,bg=DuneSurfaceRaised}
\setbeamercolor{dune evidence}{fg=DuneText,bg=DuneSurfaceRaised}
\setbeamercolor{dune violet}{fg=DuneText,bg=DuneSurfaceRaised}

\setbeamercolor{dune role primary}{fg=DuneOnAccent,bg=DunePrimary}
\setbeamercolor{dune role info}{fg=DuneOnAccent,bg=DuneInfo}
\setbeamercolor{dune role success}{fg=DuneOnAccent,bg=DuneSuccess}
\setbeamercolor{dune role warning}{fg=DuneOnAccent,bg=DuneWarning}
\setbeamercolor{dune role danger}{fg=DuneOnDanger,bg=DuneDanger}
\setbeamercolor{dune block ink}{fg=DuneText,bg=DuneSurfaceRaised}
\setbeamercolor{dune block paper}{fg=DuneOnAccent,bg=DunePaper}
\setbeamercolor{dune block sky}{fg=DuneOnAccent,bg=DuneSky}
\setbeamercolor{dune block coral}{fg=DuneOnAccent,bg=DuneCoral}
\setbeamercolor{dune block danger}{fg=DuneOnDanger,bg=DuneDanger}

% Keep projected body copy at the class's normal size. Individual components
% may step down once, but the framework never uses \tiny for meaningful text.
\setbeamerfont{normal text}{size=\normalsize}
\setbeamerfont{title}{series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize,series=\bfseries}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}

\ifPDFTeX
  \RequirePackage[scaled]{helvet}
  \renewcommand*\familydefault{\sfdefault}
  \RequirePackage[T1]{fontenc}
\else
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
  \IfFontExistsTF{Helvetica Neue}{
    \setsansfont{Helvetica Neue}
    \setmainfont{Helvetica Neue}
  }{
    \IfFontExistsTF{Helvetica}{
      \setsansfont{Helvetica}
      \setmainfont{Helvetica}
    }{
      \IfFontExistsTF{TeX Gyre Heros}{
        \setsansfont{TeX Gyre Heros}
        \setmainfont{TeX Gyre Heros}
      }{
        \IfFontExistsTF{Arial}{
          \setsansfont{Arial}
          \setmainfont{Arial}
        }{
          \IfFontExistsTF{Liberation Sans}{
            \setsansfont{Liberation Sans}
            \setmainfont{Liberation Sans}
          }{
            \setsansfont{DejaVu Sans}
            \setmainfont{DejaVu Sans}
          }
        }
      }
    }
  }
  \IfFontExistsTF{JetBrains Mono}{
    \setmonofont{JetBrains Mono}[Scale=0.88]
  }{
    \IfFontExistsTF{Latin Modern Mono}{
      \setmonofont{Latin Modern Mono}[Scale=0.88]
    }{
      \setmonofont{DejaVu Sans Mono}[Scale=0.88]
    }
  }
  \renewcommand*\familydefault{\sfdefault}
\fi

\setbeamersize{text margin left=0.78cm,text margin right=0.78cm}
\setlength{\leftmargini}{1.15em}
\setlength{\leftmarginii}{1.05em}
\setlength{\parskip}{0.18em}

\setbeamertemplate{itemize item}{%
  \color{DuneCoral}\raisebox{0.15ex}{\scriptsize$\blacktriangleright$}%
}
\setbeamertemplate{itemize subitem}{%
  \color{DuneSky}\raisebox{0.15ex}{\tiny$\blacktriangleright$}%
}

% Measured boxes: content may shrink down, but never expands outside the safe box.
\newcommand{\DuneFitBox}[3]{%
  \begin{adjustbox}{max width=#1,max totalheight=#2}%
    \begin{minipage}{#1}\raggedright #3\end{minipage}%
  \end{adjustbox}%
}

\newcommand{\DuneTightList}{%
  \setlength{\itemsep}{0.45mm}%
  \setlength{\parskip}{0pt}%
}

\newcommand{\DuneEyebrow}[1]{%
  {\color{DuneSky}\footnotesize\bfseries #1\par}%
}

\newcommand{\DunePill}[2]{%
  \tikz[baseline=-0.55ex]\node[
    rounded corners=2.5pt,
    draw=#1,
    fill=#1!18!DuneBg,
    inner xsep=4pt,
    inner ysep=1.35pt,
    text=#1,
    font=\scriptsize\bfseries
  ]{#2};%
}

% Role API. Always pair color with an explicit text label. The filled labels
% use checked foreground/background pairs from design-tokens.json.
\expandafter\def\csname DuneRoleColor@primary\endcsname{DunePrimary}
\expandafter\def\csname DuneRoleColor@decision\endcsname{DunePrimary}
\expandafter\def\csname DuneRoleColor@info\endcsname{DuneInfo}
% Calm role palette: blue explains, orange asks or cautions, and red is
% reserved for a hard danger. The explicit label carries the precise meaning.
\expandafter\def\csname DuneRoleColor@evidence\endcsname{DuneInfo}
\expandafter\def\csname DuneRoleColor@success\endcsname{DuneInfo}
\expandafter\def\csname DuneRoleColor@warning\endcsname{DunePrimary}
\expandafter\def\csname DuneRoleColor@risk\endcsname{DunePrimary}
\expandafter\def\csname DuneRoleColor@danger\endcsname{DuneDanger}
\expandafter\def\csname DuneRoleText@primary\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@decision\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@info\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@evidence\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@success\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@warning\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@risk\endcsname{DuneOnAccent}
\expandafter\def\csname DuneRoleText@danger\endcsname{DuneOnDanger}
\newcommand{\DuneRoleColor}[1]{\csname DuneRoleColor@#1\endcsname}
\newcommand{\DuneRoleText}[1]{\csname DuneRoleText@#1\endcsname}

\newcommand{\DuneRoleTag}[2]{%
  \begingroup
  \edef\DuneTagFill{\DuneRoleColor{#1}}%
  \edef\DuneTagText{\DuneRoleText{#1}}%
  \tikz[baseline=-0.55ex]\node[
    rounded corners=2.5pt,
    fill=\DuneTagFill,
    inner xsep=4.2pt,
    inner ysep=1.45pt,
    text=\DuneTagText,
    font=\scriptsize\bfseries
  ]{#2};%
  \endgroup
}

\newcommand{\DuneCallout}[4]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=5pt,rounded=true]{dune panel alt}
    \DuneRoleTag{#1}{#2}\hspace{0.55em}{\bfseries #3\par}
    \vspace{0.65mm}
    {\small #4\par}
  \end{beamercolorbox}
}

\newcommand{\DuneTakeaway}[1]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=5pt,rounded=true]{dune panel alt}
    \DuneRoleTag{primary}{TAKEAWAY}\hspace{0.55em}{\bfseries #1\par}
  \end{beamercolorbox}
}

% Layout-first components. These visual variants describe composition, not
% status. A slide normally uses one dominant light fill, with a second fill
% reserved for an actual comparison or system boundary.
\newcommand{\DuneColorBlock}[4]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=8pt,rounded=true]{dune block #1}
    {\usebeamercolor[fg]{dune block #1}\footnotesize\bfseries #2\par}
    \vspace{0.8mm}
    {\usebeamercolor[fg]{dune block #1}\large\bfseries #3\par}
    \vspace{1mm}
    {\usebeamercolor[fg]{dune block #1}\small #4\par}
  \end{beamercolorbox}%
}

\newcommand{\DuneFixedColorBlock}[5]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=8pt,rounded=true]{dune block #1}
    \begin{minipage}[t][#2][t]{\dimexpr\linewidth-16pt\relax}
      \raggedright
      {\usebeamercolor[fg]{dune block #1}\footnotesize\bfseries #3\par}
      \vspace{0.8mm}
      {\usebeamercolor[fg]{dune block #1}\large\bfseries #4\par}
      \vspace{1mm}
      {\usebeamercolor[fg]{dune block #1}\small #5\par}
    \end{minipage}
  \end{beamercolorbox}%
}

\newcommand{\DuneNumberBlock}[4]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=8pt,rounded=true]{dune block #1}
    {\usebeamercolor[fg]{dune block #1}\bfseries\fontsize{19}{21}\selectfont #2\par}
    \vspace{0.8mm}
    {\usebeamercolor[fg]{dune block #1}\large\bfseries #3\par}
    \vspace{1mm}
    {\usebeamercolor[fg]{dune block #1}\small #4\par}
  \end{beamercolorbox}%
}

\newcommand{\DuneCompactColorBlock}[4]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=5.5pt,rounded=true]{dune block #1}
    {\usebeamercolor[fg]{dune block #1}\scriptsize\bfseries #2\par}
    \vspace{0.35mm}
    {\usebeamercolor[fg]{dune block #1}\normalsize\bfseries #3\par}
    \vspace{0.45mm}
    {\usebeamercolor[fg]{dune block #1}\footnotesize #4\par}
  \end{beamercolorbox}%
}

\newcommand{\DuneCompactNumberBlock}[4]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=6pt,rounded=true]{dune block #1}
    {\usebeamercolor[fg]{dune block #1}%
      \bfseries\fontsize{16}{18}\selectfont #2\hspace{0.55em}%
      \normalsize #3\par}
    \vspace{0.5mm}
    {\usebeamercolor[fg]{dune block #1}\footnotesize #4\par}
  \end{beamercolorbox}%
}

\newcommand{\DuneBigStatement}[3]{%
  {\color{DuneSky}\footnotesize\bfseries #1\par}
  \vspace{2mm}
  {\color{DuneText}\bfseries\fontsize{21}{25}\selectfont #2\par}
  \vspace{3mm}
  {\color{DuneTextMuted}\large #3\par}
}

\newcommand{\DuneSectionPage}[3]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[DuneTitleSurface] (current page.south west) rectangle (current page.north east);
      \fill[DuneCoral]
        ($(current page.north west)+(0.88,-0.82)$) rectangle ++(1.75,0.085);
      \fill[DuneSky]
        ($(current page.south east)+(-2.9,0.86)$) rectangle ++(1.95,0.075);
      \fill[DuneSky!9!DuneTitleSurface]
        ($(current page.north east)+(-4.15,0)$) rectangle (current page.south east);
      \draw[DuneBorder,line width=0.75pt]
        ($(current page.south west)+(0.88,1.05)$)
        -- ($(current page.south east)+(-0.88,1.05)$);
    \end{tikzpicture}
    \vspace*{0.19\paperheight}
    {\color{DuneSky}\footnotesize\bfseries #1\par}
    \vspace{3mm}
    {\color{DuneText}\bfseries\fontsize{28}{32}\selectfont #2\par}
    \vspace{4mm}
    {\color{DuneTextMuted}\fontsize{13}{17}\selectfont #3\par}
  \end{frame}%
}

\newcommand{\DuneDiagramCaption}[1]{%
  {\color{DuneTextMuted}\footnotesize\textbf{Diagram.} #1\par}%
}

\newcommand{\DuneSourceLine}[2]{%
  {\color{DuneTextMuted}\scriptsize Source: \href{#2}{#1}\par}%
}

\newcommand{\DuneBlockSourceLine}[2]{%
  {\color{DuneOnAccent}\scriptsize Source:
    \href{#2}{\textcolor{DuneOnAccent}{\underline{#1}}}\par}%
}

\newcommand{\DuneCard}[4][dune panel]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=5pt,rounded=true]{#1}
    {\usebeamercolor[fg]{#1}\bfseries #2\par}
    \vspace{0.4mm}
    {\usebeamercolor[fg]{#1}\small #3\par}
    \if\relax\detokenize{#4}\relax\else
      \vspace{0.5mm}{\usebeamercolor[fg]{#1}\footnotesize #4\par}
    \fi
  \end{beamercolorbox}
}

\newcommand{\DuneFixedCard}[5][dune panel]{%
  \begin{beamercolorbox}[wd=\linewidth,sep=5pt,rounded=true]{#1}
    \begin{minipage}[t][#2][t]{\dimexpr\linewidth-10pt\relax}
      \raggedright
      {\usebeamercolor[fg]{#1}\bfseries #3\par}
      \vspace{0.45mm}
      {\usebeamercolor[fg]{#1}\small #4\par}
      \if\relax\detokenize{#5}\relax\else
        \vspace{0.55mm}{\usebeamercolor[fg]{#1}\footnotesize #5\par}
      \fi
    \end{minipage}
  \end{beamercolorbox}
}

\newcommand{\DuneFooterLogo}{%
  \IfFileExists{\DuneLogoPath/logosolo.png}{%
    \tikz[baseline=-0.52ex]\node[opacity=0.42,inner sep=0pt]{%
      \includegraphics[height=0.25cm]{\DuneLogoPath/logosolo.png}%
    };%
  }{}%
}

\newcommand{\DuneTalkDate}{%
  \@ifundefined{mydate}{\today}{\mydate}%
}

% Background and fixed frame-title band.
\addtobeamertemplate{background canvas}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[DuneBackground] (current page.south west) rectangle (current page.north east);
    \draw[DuneBorder,line width=0.55pt]
      ($(current page.south west)+(0.78,0.74)$)
      -- ($(current page.south east)+(-0.78,0.74)$);
    \fill[DuneSky!16]
      ($(current page.south east)+(-3.2,0.83)$) rectangle ++(1.45,0.055);
  \end{tikzpicture}%
}{}

\setbeamertemplate{headline}{}

\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[DuneTitleSurface]
      (current page.north west) rectangle ($(current page.north east)+(0,-1.18)$);
    \fill[DuneCoral]
      ($(current page.north west)+(0.78,-0.23)$) rectangle ++(1.38,0.055);
    \node[anchor=west,inner sep=0pt]
      at ($(current page.north west)+(0.78,-0.72)$) {%
        \DuneFitBox{\dimexpr\paperwidth-1.56cm\relax}{6.7mm}{%
          {\color{DuneText}\bfseries\fontsize{17}{20}\selectfont\insertframetitle}%
        }%
      };
    \ifx\insertframesubtitle\@empty\else
      \node[anchor=west,inner sep=0pt]
        at ($(current page.north west)+(0.78,-1.02)$) {%
          \DuneFitBox{\dimexpr\paperwidth-1.56cm\relax}{3.2mm}{%
            {\color{DuneTextMuted}\scriptsize\insertframesubtitle}%
          }%
        };
    \fi
  \end{tikzpicture}%
  \vspace*{12.5mm}%
}

\setbeamertemplate{footline}{%
  \leavevmode%
  \begin{beamercolorbox}[wd=\paperwidth,ht=6.4mm,dp=1.8mm,leftskip=0.78cm,rightskip=0.78cm]{footline}
    \DuneFooterLogo\hspace{0.45em}{\textcolor{DuneTextMuted}{\DuneTalkDate}}%
    \hfill%
    {\textcolor{DuneCoral}{\bfseries\insertframenumber}\textcolor{DuneTextMuted}{/\inserttotalframenumber}}%
  \end{beamercolorbox}%
}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[DuneBackground] (current page.south west) rectangle (current page.north east);
    \fill[DuneTitleSurface]
      (current page.north west) rectangle ($(current page.north east)+(0,-3.03)$);
    \fill[DuneCoral]
      ($(current page.north west)+(0.82,-0.58)$) rectangle ++(1.55,0.075);
    \fill[DuneSky]
      ($(current page.south east)+(-2.8,0.79)$) rectangle ++(1.88,0.065);
    \IfFileExists{\DuneLogoPath/DUNElogo_white.png}{%
      \node[anchor=south east,opacity=0.13,inner sep=0pt]
        at ($(current page.south east)+(-0.55,1.42)$) {%
        \includegraphics[width=0.34\paperwidth]{\DuneLogoPath/DUNElogo_white.png}%
      };
    }{}%
    \IfFileExists{\DuneLogoPath/FNAL-Logo-NAL-Light.png}{%
      \node[anchor=south east,inner sep=0pt]
        at ($(current page.south east)+(-0.92,0.78)$) {%
        \includegraphics[height=0.42cm]{\DuneLogoPath/FNAL-Logo-NAL-Light.png}%
      };
    }{}%
    \node[anchor=north west,inner sep=0pt]
      at ($(current page.north west)+(0.82,-0.88)$) {%
        \DuneFitBox{0.78\paperwidth}{1.48cm}{%
          {\color{DuneText}\bfseries\fontsize{25}{28}\selectfont\inserttitle}%
        }%
      };
    \node[anchor=north west,inner sep=0pt]
      at ($(current page.north west)+(0.82,-3.55)$) {%
        \DuneFitBox{0.56\paperwidth}{1.35cm}{%
          {\color{DuneTextMuted}\fontsize{13}{17}\selectfont\insertsubtitle}%
        }%
      };
    \node[anchor=north west,text=DuneSky,font=\bfseries,inner sep=0pt]
      at ($(current page.north west)+(0.82,-6.3)$) {\insertauthor};
    \node[anchor=north west,text=DuneTextMuted,font=\small,inner sep=0pt]
      at ($(current page.north west)+(0.82,-6.82)$) {\insertdate};
  \end{tikzpicture}%
  \vfill%
}

