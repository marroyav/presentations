\mode<presentation>
\usecolortheme{default}
\useinnertheme{default}
\useoutertheme{default}

% --------------------------------------
% �� FONT SIZE SETTINGS
% --------------------------------------
\setbeamerfont{normal text}{size=\scriptsize}  % Reduce main text
\setbeamerfont{footline}{}  % Ensure consistency in footline font

% --------------------------------------
% �� COLORS
% --------------------------------------
\definecolor{duneblue}{HTML}{7caed5}
\definecolor{duneorange}{HTML}{f2682b}
\definecolor{dunegrey}{gray}{0.9}           % Light grey
\definecolor{dunecolor}{RGB}{50,50,50}      % Dark grey for text

\setbeamercolor{normal text}{fg=dunecolor, bg=white}
\setbeamercolor{frametitle}{fg=duneorange, bg=white}
\setbeamercolor{section in toc}{fg=dunecolor, bg=white}
\setbeamercolor{title}{fg=duneorange}
\setbeamercolor{inverted normal text}{fg=white, bg=duneorange}
\setbeamercolor{itemize item}{fg=dunecolor}
\setbeamercolor{itemize subitem}{fg=dunecolor}
\setbeamercolor{itemize subsubitem}{fg=dunecolor}
\setbeamercolor{enumerate item}{fg=dunecolor}
\setbeamercolor{enumerate subitem}{fg=dunecolor}
\setbeamercolor{caption name}{fg=dunecolor}

% Blocks
\setbeamercolor*{block title example}{fg=duneblue}
\setbeamercolor{block title}{fg=dunecolor, bg=duneorange!30}
\setbeamercolor{block body}{fg=dunecolor, bg=gray!10}
\setbeamercolor{block title alerted}{fg=duneorange, bg=white}
\setbeamercolor{block body alerted}{bg=gray!10}
\setbeamercolor{alertblock title}{fg=white, bg=duneorange}
\setbeamercolor{alertblock body}{fg=dunecolor, bg=duneorange!15}
\setbeamercolor{exampleblock title}{fg=white, bg=duneblue}
\setbeamercolor{exampleblock body}{fg=dunecolor, bg=duneblue!15}

% --------------------------------------
% �� FONT & STRUCTURE
% --------------------------------------
\usefonttheme{structurebold}
\usepackage[scaled]{helvet}
\renewcommand*\familydefault{\sfdefault}
\usepackage[T1]{fontenc}

% --------------------------------------
% �� HEADLINE (TOP BANNER)
% --------------------------------------
\setbeamertemplate{headline}{%
\leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=15px,dp=5px]{palette quaternary}%
    \begin{columns}
    \column{.6\paperwidth}
    \column{.4\paperwidth}
    \includegraphics[width=0.35\paperwidth]{logos/lettersalone.png}
    \end{columns}
    \end{beamercolorbox}%
  }
}

% --------------------------------------
% �� FOOTLINE (BOTTOM BANNER)
% --------------------------------------
\setbeamertemplate{footline}{
\begin{beamercolorbox}[ht=17px, center]{normal text}
    \begin{columns}
    \column{.02\paperwidth} \small{\insertpagenumber}
    \column{.66\paperwidth} \small{\talkdate}
    \column{.1\paperwidth} \includegraphics[width=.1\paperwidth]{logos/logosolo.png}
    \end{columns}
    \vspace{5px}
\end{beamercolorbox}
}

% --------------------------------------
% �� DATE HANDLING COMMAND
% --------------------------------------
\newcommand{\talkdate}{
  \@ifundefined{mydate}
  {\today}
  {\mydate}
}

% --------------------------------------
% �� SPLASH SCREENS (INTRO & OUTRO)
% --------------------------------------
\newcommand{\duneSplash}{
    % DUNE blue splash page slide with white logo
    \bgroup
    \setbeamertemplate{navigation symbols}{}
    \setbeamercolor{background canvas}{bg=white}
    \frame[plain]{
    \centering
    \includegraphics[scale=0.2]{logos/DUNElogo_color.png}\\
    \includegraphics[scale=0.17]{logos/logo-uan.png}\\
    \includegraphics[scale=0.14]{logos/logo-eia.png}
    }
    \egroup
}

\newcommand{\DUNESplashWhite}{
    % DUNE ending slide with blue logo and web page
    \bgroup
    \setbeamertemplate{navigation symbols}{}
    \setbeamercolor{background canvas}{bg=gray!50}
    \frame[plain]{
        \centering
        \vspace{10px}
        \begin{figure}
            \includegraphics[scale=.3]{logos/DUNElogo_white.png} \\
        \end{figure}
    }
    \egroup
}

\mode<all>